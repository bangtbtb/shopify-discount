{%- assign col_ids = product.collections | map: 'id' -%}

<div
  id="bundle_12jdj2bvs1abbdf"
  product="{{ product.id }}"
  currency_symbol="{{ cart.currency.symbol }}"
>
  {% comment %} <p>Bundle discount</p> {% endcomment %}
</div>

<script
  async
  src="{{ "jquery.min.js" | asset_url }}"
></script>
<script src="{{ "load_bundle.js" | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ "dc.css" | asset_url }}">

<script>
  console.log('Inline script');
</script>

{% schema %}
{
  "name": "Bundle Discount",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "product", "autofill": true },
    { "type": "color", "id": "hl_color", "label": "Highlight Color", "default": "#56d356" }
  ]
}
{% endschema %}
